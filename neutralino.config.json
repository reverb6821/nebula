{
  "applicationId": "js.neutralino.zero",
  "version": "1.0.0",
  "defaultMode": "window",
  "documentRoot": "/client/dist/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "nativeAllowList": [
    "app.*",
    "filesystem.readDirectory"
  ],
  "modes": {
    "window": {
      "title": "nebula-dock",
      "width": 800,
      "height": 500,
      "minWidth": 400,
      "minHeight": 200,
      "icon": "/client/public/favicon.ico"
    }
  },
  "cli": {
    "binaryName": "nebula-dock",
    "resourcesPath": "/www/",
    "extensionsPath": "/extensions/",
    "binaryVersion": "6.8.0",
    "clientVersion": "6.8.0",
     "frontendLibrary": {
        "patchFile": "/client/index.html",
        "devUrl": "http://localhost:5173",
        "projectPath": "/client/",
        "initCommand": "pnpm install",
        "devCommand": "BROWSER=none pnpm dev",
        "buildCommand": "pnpm build"
    }
  }
}