{
  "applicationId": "com.nebula.dock",
  "version": "0.0.1",
  "defaultMode": "window",
  "documentRoot": "/client/dist/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "nativeAllowList": [
    "app.*",
    "filesystem.readDirectory",
    "os.*",
    "filesystem.*"
  ],
  "modes": {
    "window": {
      "title": "nebula-dock",
      "width": 1280,
      "height": 800,
      "minWidth": 800,
      "minHeight": 500,
      "icon": "/client/src/assets/logo.png"
    }
  },
  "cli": {
    "binaryName": "nebula-dock",
    "resourcesPath": "/client/dist/",
    "extensionsPath": "/extensions/",
    "binaryVersion": "6.8.0",
    "clientVersion": "6.8.0"
  }
}