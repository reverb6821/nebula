{
  "applicationId": "com.nebula.dock",
  "version": "0.0.1",
  "defaultMode": "window",
  "documentRoot": "/client/dist/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "nativeAllowList": [
    "app.*",
    "filesystem.readDirectory",
    "os.*",
    "filesystem.*"
  ],
  "modes": {
    "window": {
      "title": "nebula-dock",
      "width": 1280,
      "height": 800,
      "minWidth": 800,
      "minHeight": 500,
      "icon": "/client/public/favicon.ico",
      "enableInspector": true
    }
  },
  "cli": {
    "binaryName": "nebula-dock",
    "resourcesPath": "/www/",
    "extensionsPath": "/extensions/",
    "binaryVersion": "6.8.0",
    "clientVersion": "6.8.0",
     "frontendLibrary": {
        "patchFile": "/client/index.html",
        "devUrl": "http://localhost:5173",
        "projectPath": "/client/",
        "initCommand": "pnpm install",
        "devCommand": "BROWSER=none pnpm dev",
        "buildCommand": "pnpm build"
    }
  }
}